# Copy to backend/.env.local. Fill keys from `supabase status` for YOUR local stack.
# Never copy production credentials here. backend/.env.local overrides backend/.env.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=replace-with-local-service-role-key

# Direct Postgres: verify against `supabase status`. SUPABASE_DB_URL takes precedence.
# Explicit blanks prevent an existing backend/.env from selecting a hosted database.
SUPABASE_DB_URL=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local defaults: no scheduled scans, ingestion, catch-up retries, or prewarming.
# Startup hooks and manually requested operations can still write to the local DB.
DISABLE_SCHEDULER=1
DISABLE_BOOT_HEAL=1
ASSET_QUEUE_INPROCESS=0
SECTOR_TIMELINE_PREWARM=0
BLEND_PREWARM=
DISABLE_LAZY_REPRICE=1

# Optional integrations: leave blank until working on the corresponding feature.
BROKER_USERNAME=
BROKER_PASSWORD=
GURUFOCUS_API_KEY=
OPENFIGI_API_KEY=
LEONTEQ_USER=
LEONTEQ_PASSWORD=
# Legacy Leonteq aliases, cleared to avoid inheriting credentials from backend/.env.
LYNQS_USER=
LYNQS_PASS=
LONGEQUITY_BASE_URL=
LONGEQUITY_FILENAME_TEMPLATE=
ANTHROPIC_API_KEY=
CRON_SECRET=
BLEND_CACHE_REDIS_URL=

# Standard localhost frontend origins are already allowed. Add origins only if needed.
CORS_ORIGINS=
LOG_LEVEL=INFO
