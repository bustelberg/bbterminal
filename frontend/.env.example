# Copy to frontend/.env.local. Use the SAME local Supabase instance as the backend.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# NEXT_PUBLIC_* values are browser-visible. Never put service-role keys, database
# passwords, broker credentials or vendor API keys in this file.
